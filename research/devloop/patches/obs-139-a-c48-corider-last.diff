+_OBS_MENTION = re.compile(r"관측\s+(\d+)")
+
+
+def header_coriders(line: str) -> list[int]:
+    """«보강» 헤더에 **동승**한 둘째 이후 관측 번호 (관측 139 잔여 사각 · c322). **순수 함수**.
+
+    한 헤더가 여러 관측을 나른다 — c302가 시작한 «여러 관측 = 1절» 서식(c317·c318 실측:
+    `## 관측 137 보강 (사이클 317, …) — … 관측 138 첫 보강 … · 관측 136 ① 전사`). header_kind는
+    첫 번호 하나만 읽으므로 동승분의 `last`는 갱신되지 않았다(관측 139 «잔여 사각 (선언)»).
+    정의역 = header_kind가 «보강»으로 읽는 행만 — 원본 헤더의 계보 인용(«관측 29의 3세대»)은
+    보강이 아니고, 헤더 밖 산문은 어떤 번호도 나르지 않는다. 첫 번호 제외 · 중복 제거 · 등장 순.
+    한계(정직): 헤더 **안** 인용(«관측 107 규율»)도 동승으로 읽는다 — 과계상 방향이며 닿는 값은
+    `last` 하나다(tagged·exited·opened·title 무접촉). 비-보강 행·비-헤더 행은 [].
+    """
+    hk = header_kind(line)
+    if not hk or hk[1] != "보강":
+        return []
+    first = hk[0]
+    out: list[int] = []
+    for m in _OBS_MENTION.finditer(line):
+        n = int(m.group(1))
+        if n != first and n not in out:
+            out.append(n)
+    return out
+
