+def deadline_bucket(cyc: int | None, cal: str | None, n_now: int, today: str
+                    ) -> tuple[str, str | None, int | None]:
+    """파트 D 기한 분류 — **순수 함수**. (bucket, 표시 기한, gap) 반환. 인자만 본다.
+
+    bucket ∈ {"due", "overdue", "future", "none"}. 사이클 축은 gap = cyc − n_now(0 = 오늘),
+    달력 축은 gap = 0(**당일**) · None(그 밖 — 인쇄가 «달력 기한 도과»/«달력 기한»으로 가른다).
+    두 축이 다 있으면 사이클 축이 먼저다(c164 인라인 if/elif 순서 보존).
+
+    왜 함수인가 (관측 137 · c312 · diff c315→c318). c164~의 분기는 part_d 안 인라인이었고
+    달력 축에 `cal < today` 한 술어뿐이라 마감일 **당일**이 «예정»으로 떨어졌다(P36 2026-09-10 ·
+    c312~c316 다섯 사이클 침묵 · 사건 1). 인라인이면 회귀가 part_d 전체(실 대장·원장·계기 큐
+    직독)를 불러야 시험된다(관측 129 부류) — 그래서 분류만 여기로 뽑고 인쇄는 part_d에 둔다.
+    """
+    if cyc is not None:
+        gap = cyc - n_now
+        return ("due" if gap == 0 else "overdue" if gap < 0 else "future", f"c{cyc}", gap)
+    if cal is not None:
+        if cal == today:
+            return ("due", cal, 0)
+        return ("overdue" if cal < today else "future", cal, None)
+    return ("none", None, None)
+
+
