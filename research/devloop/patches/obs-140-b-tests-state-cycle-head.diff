diff --git a/tests/test_devloop_step0_parsing.py b/tests/test_devloop_step0_parsing.py
--- a/tests/test_devloop_step0_parsing.py
+++ b/tests/test_devloop_step0_parsing.py
@@ -156,3 +156,36 @@
     state_cycle, verdict = c48.task_state_lag(92, "다른 태스크의 요약문입니다")
     assert state_cycle is None
     assert verdict.startswith("판정 불가")
+
+
+# ---- 관측 140 (c321 · audit-320 R2): 문두 «cN 완료»가 인용된 «사이클 M»보다 먼저다 -----------
+#
+# c93~c320 파트 S·㉼가 «일치»로 인쇄한 세대 번호는 전부 summary 문면의 첫 «사이클 N» 매치였다 —
+# c320은 903번째 문자의 인용문 «(사이클 319»를 c319 세대로 읽었고(우연 일치), c319·c320 자신의
+# «c320 완료(…)» 문두 서식은 «판정 불가»로 떨어졌다. 같은 정규식이 두 자리(task_state_lag · ㉼ 인라인)에
+# 살았으므로 술어를 순수 함수 하나로 모으고 문두를 먼저 읽는다. 실 스토어 직독 0.
+
+
+def test_state_cycle_head_form_wins_over_a_quoted_cycle_number():
+    s = "c320 완료(**적대 감사**·하네스 C) · ⑥ 파트 S 눈은 «cN 완료» 서식을 못 읽는다 — «일치 319»는 인용문 «(사이클 319» 우연"
+    assert c48.state_cycle_from_summary(s) == 320
+    assert c48.task_state_lag(320, s) == (320, "일치")
+
+
+def test_state_cycle_quoted_later_number_does_not_mask_lag():
+    # 세대는 c319인데 본문이 «사이클 320»을 인용한다 — 구본은 320을 읽어 «일치»로 접었을 자리.
+    s = "c319 완료(일반) · 다음 = 사이클 320 후보 서열"
+    assert c48.task_state_lag(320, s) == (319, "지연")
+
+
+def test_state_cycle_head_form_without_any_citation_is_readable():
+    # c320 실 summary 모양: «사이클» 뒤에 숫자가 오는 자리가 없다(«205사이클째» · «10/10사이클 상수») → 구본 판정 불가.
+    s = "c320 완료(**적대 감사**·rt 2) · 서수 «205사이클째» = 28일 · recall hits 10/10사이클 상수"
+    assert c48.state_cycle_from_summary(s) == 320
+    assert c48.task_state_lag(320, s) == (320, "일치")
+
+
+def test_state_cycle_falls_back_to_citation_then_none():
+    assert c48.state_cycle_from_summary("[devloop 사이클 92 — 완주]") == 92
+    assert c48.state_cycle_from_summary("다른 태스크의 요약문입니다") is None
+    assert c48.state_cycle_from_summary("서수 «205사이클째»만 있는 문면") is None
