diff --git a/tests/test_task_state_single_echo.py b/tests/test_task_state_single_echo.py
new file mode 100644
--- /dev/null
+++ b/tests/test_task_state_single_echo.py
@@ -0,0 +1,91 @@
+"""관측 141 (c326 diff): a single-task get_task_state carries the body once.
+
+The response used to hold the same claim as ``current`` and again as
+``results[0]`` -- twice the body on every devloop step 0 (c323~c325: 34~38KB vs
+a 17~19KB body), enough to cross the harness auto-save threshold and cost a
+file Read per cycle. Contract: ``task_id`` given and exactly one row found ->
+``current`` is the body and ``results[0]`` is a reference row; list queries and
+the absent case keep their old shape. Values here are synthetic (관측 100).
+"""
+
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+
+from forget import db as app_db
+from forget.db import init_db
+from forget.store import get_task_state, record_task_state
+from forget.utils import utc_now
+
+_DB_COUNTER = 0
+LONG = ("c326 상태 문장 " * 400).strip()  # ~4.8k chars: the echo doubled a body this size (stored summary is stripped)
+
+
+def _fresh_db() -> None:
+    global _DB_COUNTER
+    _DB_COUNTER += 1
+    path = Path(f"/tmp/mem1-task-single-echo-{os.getpid()}-{_DB_COUNTER}.sqlite3")
+    for suffix in ("", "-wal", "-shm"):
+        path.with_name(path.name + suffix).unlink(missing_ok=True)
+    os.environ["MEM1_DB_PATH"] = str(path)
+    app_db.DB_PATH = path
+    init_db()
+
+
+# ---- 관측 141 계약 -----------------------------------------------------------------------
+
+def test_single_task_query_carries_body_once():
+    """판별 ①: task_id 지정 ∧ count == 1 → current가 본문 · results[0]는 참조(claim_id · ref=current)."""
+    _fresh_db()
+    record_task_state({"task_id": "devloop", "status": "in_progress", "summary": LONG, "next_actions": ["a", "b"]})
+    resp = get_task_state({"task_id": "devloop"})
+    assert resp["count"] == 1
+    assert resp["current"]["summary"] == LONG
+    assert resp["current"]["next_actions"] == ["a", "b"]
+    ref = resp["results"][0]
+    assert ref["ref"] == "current"
+    assert ref["claim_id"] == resp["current"]["claim_id"]
+    assert ref["task_id"] == "devloop"
+    assert "summary" not in ref and "next_actions" not in ref
+
+
+def test_single_task_response_is_about_one_body():
+    """판별 ②: 응답 − current < current — 수용 기준 ① «results 제거 = 본문 1배» 술어."""
+    _fresh_db()
+    record_task_state({"task_id": "devloop", "status": "in_progress", "summary": LONG})
+    resp = get_task_state({"task_id": "devloop"})
+    whole = len(json.dumps(resp, ensure_ascii=False))
+    body = len(json.dumps(resp["current"], ensure_ascii=False))
+    assert whole - body < body, f"envelope {whole - body} chars around a {body}-char body"
+
+
+def test_single_task_replay_as_of_dedupes_too():
+    """판별 ③: as_of 재생 단일 조회도 같은 봉투 — results[0] 참조 · freshness는 replay."""
+    _fresh_db()
+    record_task_state({"task_id": "devloop", "status": "in_progress", "summary": "replay"})
+    resp = get_task_state({"task_id": "devloop", "as_of": utc_now()})
+    assert resp["count"] == 1 and resp["current"]["summary"] == "replay"
+    assert resp["results"][0]["ref"] == "current"
+    assert resp["freshness"]["state"] == "replay"
+
+
+def test_list_query_shape_is_unchanged():
+    """불변 ①: task_id 미지정 목록 조회 — results 전건 본문 · current == results[0] · count = 행 수."""
+    _fresh_db()
+    record_task_state({"task_id": "devloop", "status": "in_progress", "summary": "one"})
+    record_task_state({"task_id": "heartbeat", "status": "in_progress", "summary": "two"})
+    resp = get_task_state({"limit": 20})
+    assert resp["count"] == 2
+    assert all("summary" in row and "ref" not in row for row in resp["results"])
+    assert resp["current"] == resp["results"][0]
+
+
+def test_absent_task_still_reports_nothing():
+    """불변 ②: 없는 task_id — count 0 · current None · results [] · freshness absent."""
+    _fresh_db()
+    record_task_state({"task_id": "heartbeat", "status": "in_progress", "summary": "two"})
+    resp = get_task_state({"task_id": "devloop"})
+    assert resp["count"] == 0 and resp["current"] is None and resp["results"] == []
+    assert resp["freshness"]["state"] == "absent"
