+def _task_state_ref(row: dict[str, Any]) -> dict[str, Any]:
+    """Reference row for a single-task query (관측 141, c326 diff).
+
+    A single-task ``get_task_state`` used to carry the same claim twice -- once
+    as ``current`` and again as ``results[0]`` -- so the response was twice the
+    body (c323~c325: 34~38KB against a 17~19KB body) and crossed the harness
+    auto-save threshold every cycle. ``current`` is the body; ``results`` keeps
+    its list shape but holds this reference instead of a second copy.
+    """
+    return {
+        "task_id": row.get("task_id"),
+        "claim_id": row.get("claim_id"),
+        "ref": "current",
+    }
+
+
+def _task_state_list_response(
+    results: list[dict[str, Any]],
+    *,
+    project_id: str | None,
+    as_of: str,
+    state_source: str,
+    single: bool,
+) -> dict[str, Any]:
+    """One envelope for both ``get_task_state`` branches (epoch / claim ledger).
+
+    List queries (no task_id, or more than one row) are unchanged: ``results``
+    carries every row and ``current`` mirrors ``results[0]``. A single-task
+    query (``single`` and exactly one row) carries the body once, in
+    ``current``; ``results[0]`` is the reference row from ``_task_state_ref``.
+    ``count`` stays the number of rows found.
+    """
+    current = results[0] if results else None
+    listed = [_task_state_ref(current)] if (single and current is not None and len(results) == 1) else results
+    return {
+        "schema_version": "mem1-task-state-list-v1",
+        "project_id": project_id,
+        "replay_as_of": as_of,
+        "count": len(results),
+        "results": listed,
+        "current": current,
+        "freshness": task_state_freshness(current, as_of),
+        "state_source": state_source,
+    }
+
+
