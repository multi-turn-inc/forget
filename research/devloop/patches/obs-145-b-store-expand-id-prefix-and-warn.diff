+def _context_outcome_expand_id_prefixes(payload: dict[str, Any], selected_ids: list[Any]) -> dict[str, Any]:
+    """Expand >=8-char memory-id prefixes in used/missing/harmful_memory_ids to the unique trace id they prefix.
+
+    관측 145 (2026-09-13, c346): the turn-recall injection block prints each memory's 8-char id
+    prefix (hooks/forget_turnrecall.py) because ranking feedback only closes when the outcome
+    carries memory ids — `_close_outcome_feedback_loop` returns on an empty id set, so a bare
+    `outcome=noise` was a trace-level annotation for 16 devloop cycles. Expansion is scoped to
+    this trace's selected_ids; an ambiguous or unknown prefix is left as-is and falls through to
+    the existing unmatched_memory_ids warning. Full ids and short (<8) fragments pass unchanged.
+    """
+    candidates = [str(value) for value in selected_ids if value]
+    if not candidates:
+        return payload
+
+    def _expand(values: Any) -> Any:
+        if not isinstance(values, list):
+            return values
+        out: list[Any] = []
+        for value in values:
+            text = str(value or "").strip()
+            hits = (
+                [candidate for candidate in candidates if candidate.startswith(text)]
+                if len(text) >= 8 and text not in candidates
+                else []
+            )
+            out.append(hits[0] if len(hits) == 1 else value)
+        return out
+
+    expanded = dict(payload)
+    observed = expanded.get("observed") if isinstance(expanded.get("observed"), dict) else None
+    for key in ("used_memory_ids", "missing_memory_ids", "harmful_memory_ids"):
+        if key in expanded:
+            expanded[key] = _expand(expanded[key])
+        if observed is not None and key in observed:
+            observed = dict(observed)
+            observed[key] = _expand(observed[key])
+            expanded["observed"] = observed
+    return expanded
+
+
